# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (CORS քաղաքականության թույլատրված Origin-ի համար)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# (Թող միայն այն տարբերակը, որն իրականում օգտագործում ես քո server/.env-ում)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/eduspace_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=eduspace_db

# Authentication (JWT)
JWT_SECRET=replace_with_a_strong_random_64_char_secret
JWT_EXPIRES_IN=7d

# File Storage (Անջատիր մեկնաբանությունը, եթե ավատարների համար օգտագործում ես Cloudinary/S3)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret